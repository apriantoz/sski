---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Profil from '../components/Profil.astro';
import Jadwal from '../components/Jadwal.astro';
import Kontak from '../components/Kontak.astro';
import Kegiatan from '../components/Kegiatan.astro';
import Medsos from '../components/Medsos.astro';
import Footer from '../components/Footer.astro';
import Pembina from '../components/Pembina.astro';
import Fasilitas from '../components/Fasilitas.astro';
import Galeri from '../components/Galeri.astro';
---

<Layout title="Sanggar Seni Kebo Iwa - Profil & Portofolio">
  <Navbar />
  <main>
    <Hero />
	<Kegiatan />
    <Profil />
    <Pembina />
    <Fasilitas />
    <Jadwal />
    <Galeri limit={9} />
    <Medsos />
    <Kontak />
  </main>
  <Footer />
</Layout>
