---
// src/components/Galeri.astro

const fotoList = [
  { url: "https://picsum.photos/600/400?random=1", alt: "Pementasan Tari Tradisional" },
  { url: "https://picsum.photos/600/400?random=2", alt: "Latihan Karawitan & Tabuh" },
  { url: "https://picsum.photos/600/400?random=3", alt: "Persiapan & Geladi Bersih" },
  { url: "https://picsum.photos/600/400?random=4", alt: "Keseruan Anggota Sanggar" },
];
---

<section id="galeri" class="py-20 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto bg-black text-white border-b border-neutral-900">
  
  <!-- Header Section -->
  <div class="mb-12 space-y-2 text-center md:text-left">
    <div class="flex items-center justify-center md:justify-start gap-2 text-red-600 font-mono text-xs uppercase tracking-widest">
      <span class="w-2 h-2 rounded-full bg-red-600"></span>
      Dokumentasi
    </div>

    <h2 class="text-[clamp(2rem,4vw,3.25rem)] font-extrabold tracking-tight leading-tight">
      Galeri Kegiatan
    </h2>

    <p class="text-neutral-400 text-[clamp(0.95rem,1.5vw,1.15rem)] max-w-xl font-light">
      Momen-momen pementasan, proses latihan harian, dan kebersamaan keluarga besar sanggar.
    </p>
  </div>

  <!-- Minimalist Photo Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
    {fotoList.map((foto) => (
      <div class="relative overflow-hidden rounded-xl border border-neutral-900 bg-neutral-950 group">
        
        <!-- Image Container -->
        <div class="aspect-4/3 overflow-hidden">
          <img 
            src={foto.url} 
            alt={foto.alt} 
            class="w-full h-full object-cover filter grayscale contrast-110 group-hover:filter-none group-hover:scale-105 transition-all duration-500 ease-out"
            loading="lazy"
          />
        </div>

        <!-- Caption Overlay -->
        <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
          <p class="text-xs font-mono text-neutral-200 tracking-tight">
            {foto.alt}
          </p>
        </div>

      </div>
    ))}
  </div>

</section>