---
// 1. Interface TypeScript
export interface Instructor {
  name: string;
  role: string;
  specialty: string;
}

export interface Program {
  title: string;
  schedule: string;
  target: string;
  description: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
  instructors?: Instructor[];
  programs?: Program[];
}

// 2. Data Default
const defaultInstructors: Instructor[] = [
  {
    name: "I Wayan Agus Putra, S.Sn.",
    role: "Pelatih Gamelan & Karawitan",
    specialty: "Tabuh Tradisional & Kreasi Baru"
  },
  {
    name: "Ni Putu Ratna Dewi, S.Pd.",
    role: "Pelatih Tari Bali",
    specialty: "Tari Legong, Tari Putri, & Tari Kreasi"
  }
];

const defaultPrograms: Program[] = [
  {
    title: "Kelas Tari Bali Regular",
    schedule: "Sabtu & Minggu (15.00 - 17.00 WITA)",
    target: "Anak-anak & Remaja",
    description: "Pembelajaran teknik dasar (agem, melek, angsel) hingga ragam tarian klasik dan kreasi."
  },
  {
    title: "Kelas Tabuh / Gamelan Bali",
    schedule: "Jumat & Sabtu (18.30 - 20.30 WITA)",
    target: "Umum & Wisatawan",
    description: "Pengenalan ritme, teknik pukulan instrumen gamelan (gangsa, reyong, kendang), serta komposisi tabuh."
  },
  {
    title: "Private & Intensive Class",
    schedule: "Jadwal Fleksibel (By Request)",
    target: "Perorangan / Grup Privat",
    description: "Pendampingan intensif untuk persiapan ujian seni, pentas khusus, atau workshop privat."
  }
];

// 3. Destrukturisasi Props
const {
  title = "SANGGAR SENI PENDOPO TAMAN SSKI",
  subtitle = "Wadah Pelestarian, Edukasi, dan Ekspresi Seni Budaya Bali",
  description = "Sanggar Seni Pendopo Taman SSKI berkomitmen untuk menjaga keaslian serta mengembangkan seni pertunjukan Bali melalui pendidikan tari dan gamelan bagi generasi muda maupun pencinta budaya dari seluruh dunia.",
  instructors = defaultInstructors,
  programs = defaultPrograms
} = Astro.props;
---

<section id="sanggar-seni" class="max-w-7xl mx-auto p-4 sm:p-6 font-sans">
  <!-- Header Sanggar -->
  <div class="text-center mb-12">
    <span class="text-amber-600 font-semibold text-xs sm:text-sm tracking-widest uppercase">Cultural Arts Academy</span>
    <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-wide mt-1">
      {title}
    </h2>
    <p class="text-amber-700 font-medium text-sm sm:text-base mt-1">
      {subtitle}
    </p>
    <p class="text-slate-600 mt-3 text-sm sm:text-base max-w-3xl mx-auto leading-relaxed">
      {description}
    </p>
  </div>

  <!-- Program Latihan Sanggar -->
  <div class="mb-14">
    <h3 class="text-xl font-bold text-slate-800 mb-6 flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
      Program & Kelas Sanggar
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {programs.map((prog: Program) => (
        <article class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <span class="bg-amber-100 text-amber-900 text-xs font-semibold px-2.5 py-1 rounded-full">
              {prog.target}
            </span>
            <h4 class="text-lg font-bold text-slate-900 mt-3">{prog.title}</h4>
            <p class="text-xs font-medium text-amber-700 mt-1 mb-3">
              🕒 {prog.schedule}
            </p>
            <p class="text-sm text-slate-600 leading-relaxed">
              {prog.description}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100">
            <button class="w-full text-xs font-bold text-slate-900 bg-slate-100 hover:bg-amber-500 hover:text-slate-950 py-2.5 rounded-xl transition-colors">
              Daftar Program
            </button>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Tim Pengajar / Instruktur -->
  <div class="bg-slate-950 text-white rounded-3xl p-6 sm:p-10 border border-amber-900/40 shadow-xl">
    <div class="text-center sm:text-left mb-8">
      <h3 class="text-xl sm:text-2xl font-bold text-amber-400">Pelatih & Pengajar Sanggar</h3>
      <p class="text-slate-400 text-xs sm:text-sm mt-1">
        Dipelajari langsung dari para praktisi dan akademisi seni Bali yang berpengalaman.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {instructors.map((ins: Instructor) => (
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 flex items-start gap-4">
          <div class="w-12 h-12 rounded-full bg-amber-500/20 text-amber-400 flex items-center justify-center font-bold shrink-0 text-lg">
            {ins.name.charAt(0)}
          </div>
          <div>
            <h4 class="font-bold text-white text-base">{ins.name}</h4>
            <p class="text-amber-400 text-xs font-medium">{ins.role}</p>
            <p class="text-slate-400 text-xs mt-2 italic">
              Keahlian: {ins.specialty}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>