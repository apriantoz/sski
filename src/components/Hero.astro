---
// 1. Definisikan array gambar di dalam Frontmatter
const heroImages = [
  '/images/hero-bg-1.jpg',
  '/images/hero-bg-2.jpg',
  '/images/hero-bg-3.jpg',
];

// 2. Pilih gambar acak saat request/render
const randomBg = heroImages[Math.floor(Math.random() * heroImages.length)];
---

<section 
  style={`background-image: url('${randomBg}')`}
  class="relative min-h-screen flex items-center justify-center bg-stone-950 text-stone-100 px-4 text-center border-b border-stone-800 bg-cover bg-center bg-no-repeat overflow-hidden"
>
  
  <!-- Overlay Hitam Transparan (60%) -->
  <div class="absolute inset-0 bg-black/60 z-0"></div>

  <!-- Konten Utama dengan Animasi -->
  <div class="max-w-3xl mx-auto relative z-10 py-12 space-y-6">
    
    <!-- Title dengan Fade In & Slide Up (Delay 0ms) -->
    <h1 class="text-4xl md:text-6xl font-bold text-rose-500 drop-shadow-lg leading-tight animate-fade-in-up">
      Melestarikan Budaya, Memperindah Karya
    </h1>

    <!-- Deskripsi dengan Fade In & Slide Up (Delay 200ms) -->
    <p class="text-stone-100 text-lg md:text-xl drop-shadow max-w-2xl mx-auto font-light leading-relaxed animate-fade-in-up opacity-0 [animation-delay:200ms]">
      Wadah kreativitas seni tari, musik, dan seni rupa tradisional & modern.
    </p>

    <!-- Tombol dengan Fade In & Slide Up (Delay 400ms) + Efek Hover/Active -->
    <div class="pt-4 animate-fade-in-up opacity-0 [animation-delay:400ms]">
      <a 
        href="#galeri" 
        class="bg-rose-600 hover:bg-rose-500 text-neutral-100 font-bold px-8 py-3.5 rounded-full transition duration-300 transform hover:scale-105 active:scale-95 inline-block shadow-lg shadow-rose-950/50"
      >
        Lihat Dokumentasi
      </a>
    </div>

  </div>
</section>

<!-- CSS Animasi Kustom Bawaan (Scoped otomatis oleh Astro) -->
<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>