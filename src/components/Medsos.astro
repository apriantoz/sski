---
// src/components/Medsos.astro

const medsos = [
  {
    nama: "Instagram",
    handle: "@sanggarsenikeboiwaa",
    deskripsi: "Dokumentasi foto pementasan, info kegiatan, dan cerita harian.",
    url: "https://instagram.com/sanggarsenikeboiwaa",
    ikon: "fa-brands fa-instagram"
  },
  {
    nama: "TikTok",
    handle: "@sanggar.seni.kebo",
    deskripsi: "Cuplikan video latihan tari, di balik layar, dan keseruan anggota.",
    url: "https://tiktok.com/@sanggar.seni.kebo",
    ikon: "fa-brands fa-tiktok"
  },
  {
    nama: "YouTube",
    handle: "Sanggar Seni Kebo Iwa",
    deskripsi: "Video pertunjukan tari tradisional penuh dan karya karawitan.",
    url: "https://youtube.com/@sanggarsenikeboiwa",
    ikon: "fa-brands fa-youtube"
  }
];
---

<section id="medsos" class="py-20 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto text-white border-b border-neutral-900">
  
  <!-- Header Section -->
  <div class="mb-12 space-y-2 text-center md:text-left">
    <div class="flex items-center justify-center md:justify-start gap-2 text-red-600 font-mono text-xs uppercase tracking-widest">
      <span class="w-2 h-2 rounded-full bg-red-600"></span>
      Kanal Digital
    </div>

    <h2 class="text-[clamp(2rem,4vw,3.25rem)] font-extrabold tracking-tight leading-tight">
      Media Sosial
    </h2>

    <p class="text-neutral-400 text-[clamp(0.95rem,1.5vw,1.15rem)] max-w-xl font-light">
      Ikuti update latihan, karya terbaru, dan keseruan aktivitas sanggar langsung dari kanal favorit Anda.
    </p>
  </div>

  <!-- Ultra-Clean Interactive List (No Arrows) -->
  <div class="divide-y divide-neutral-900 border-t border-b border-neutral-900">
    {medsos.map((item) => (
      <a 
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        class="py-6 sm:py-8 flex flex-col md:flex-row md:items-center justify-between gap-4 group hover:pl-2 transition-all duration-300"
      >
        <!-- Platform Name & Icon -->
        <div class="flex items-center gap-4 md:w-2/5">
          <span class="text-2xl text-neutral-500 group-hover:text-red-600 transition duration-300">
            <i class={item.ikon}></i>
          </span>
          <div>
            <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight group-hover:text-red-600 transition duration-300">
              {item.nama}
            </h3>
            <span class="text-neutral-500 font-mono text-xs block mt-0.5">
              {item.handle}
            </span>
          </div>
        </div>

        <!-- Deskripsi -->
        <div class="md:w-3/5">
          <p class="text-neutral-400 text-xs sm:text-sm font-light leading-relaxed">
            {item.deskripsi}
          </p>
        </div>
      </a>
    ))}
  </div>

</section>