---
// 1. Definisikan array gambar di dalam Frontmatter (area ---)
const heroImages = [
  '/sski/images/hero-bg-1.jpg',
  '/sski/images/hero-bg-2.jpg',
  '/sski/images/hero-bg-3.jpg',
];

// 2. Pilih gambar acak saat request/render
const randomBg = heroImages[Math.floor(Math.random() * heroImages.length)];
---

<!-- 3. Pasang variabel `randomBg` ke inline style `background-image` -->
<section 
  style={`background-image: url('${randomBg}')`}
  class="relative min-h-screen flex items-center justify-center bg-stone-950 text-stone-100 px-4 text-center border-b border-stone-800 bg-cover bg-center bg-no-repeat"
>
  
  <!-- Overlay Hitam Transparan (60%) -->
  <div class="absolute inset-0 bg-black/60 z-0"></div>

  <!-- Konten Utama -->
  <div class="max-w-3xl mx-auto relative z-10 py-12">
    <h1 class="text-4xl md:text-6xl font-serif font-bold text-amber-500 mb-4 drop-shadow-lg leading-tight">
      Melestarikan Budaya, Memperindah Karya
    </h1>
    <p class="text-stone-100 text-lg md:text-xl mb-8 drop-shadow">
      Wadah kreativitas seni tari, musik, dan seni rupa tradisional & modern.
    </p>
    <a 
      href="#galeri" 
      class="bg-amber-600 hover:bg-amber-500 text-stone-950 font-bold px-8 py-3.5 rounded-full transition duration-200 transform active:scale-95 inline-block shadow-lg"
    >
      Lihat Dokumentasi
    </a>
  </div>
</section>