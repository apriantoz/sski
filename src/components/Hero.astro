---
// Daftar gambar dalam array Astro Frontmatter
const heroImages = [
  '/images/hero-bg-1.jpg',
  '/images/hero-bg-2.jpg',
  '/images/hero-bg-3.jpg',
];

// Gambar default/fallback saat SSR/Build
const defaultBg = heroImages[0];
---

<section 
  id="hero-section"
  style={`background-image: url('${defaultBg}')`}
  data-images={JSON.stringify(heroImages)}
  class="relative min-h-screen flex items-center justify-center text-white px-4 sm:px-6 lg:px-8 text-center border-b border-red-900/50 bg-cover bg-center bg-no-repeat overflow-hidden transition-[background-image] duration-700"
>
  <!-- Overlay Hitam Pekat dengan Gradien Merah Gelap di Bawah -->
  <div class="absolute inset-0 bg-linear-to-b from-black/85 via-black/75 to-red-950/90 z-0" aria-hidden="true"></div>

  <!-- Konten Utama Responsif -->
  <div class="w-full max-w-4xl mx-auto relative z-10 my-8 sm:my-12 py-8 px-4 space-y-6 sm:space-y-8">

    <!-- Title Utama (Diperbaiki spasinya dengan mr-2 / &nbsp;) -->
    <h1 class="text-[clamp(2.5rem,6vw,4.5rem)] font-extrabold text-white leading-[1.1] tracking-tight animate-fade-in-up opacity-0 [animation-delay:150ms]">
      <span class="bg-linear-to-r from-red-600 via-red-500 to-red-700 bg-clip-text text-transparent inline-block mr-2 sm:mr-0">
        Sanggar Seni
      </span><br class="hidden sm:inline" />
      <span class="text-white">Kebo Iwa</span>
    </h1>

    <!-- Deskripsi / Tagline -->
    <p class="text-neutral-300 text-[clamp(1rem,2vw,1.35rem)] max-w-2xl mx-auto font-light leading-relaxed tracking-wide animate-fade-in-up opacity-0 [animation-delay:300ms]">
      Melestarikan budaya, memperindah karya.
    </p>

    <!-- Tombol CTA -->
    <div class="pt-4 animate-fade-in-up opacity-0 [animation-delay:450ms]">
      <a 
        href="#kontak" 
        class="bg-red-600/50 hover:bg-red-700/50 text-white font-semibold text-[clamp(0.85rem,1.2vw,1rem)] uppercase tracking-wider px-8 py-3.5 rounded-full transition duration-300 transform hover:scale-105 active:scale-95 inline-block shadow-lg shadow-red-950/80 border border-white/20"
      >
        Bergabung dengan Kami
      </a>
    </div>

  </div>
</section>

<!-- Script Client-Side untuk GitHub Pages -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const hero = document.getElementById('hero-section');
    if (!hero) return;

    const imagesData = hero.getAttribute('data-images');
    if (!imagesData) return;

    try {
      const images = JSON.parse(imagesData);
      if (Array.isArray(images) && images.length > 0) {
        const randomImage = images[Math.floor(Math.random() * images.length)];
        
        const img = new Image();
        img.src = randomImage;
        img.onload = () => {
          hero.style.backgroundImage = `url('${randomImage}')`;
        };
      }
    } catch (err) {
      console.error('Gagal mengacak gambar hero:', err);
    }
  });
</script>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>