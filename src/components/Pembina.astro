---
// src/components/Pembina.astro

const pembina = {
  nama: "I Nyoman Mariyana",
  gelar: "S.Sn., M.Sn.",
  jabatan: "Pembina & Pendiri Sanggar",
  foto: "/images/mang-bo.jpg", 
  bio: "Dedikasi lebih dari 15 tahun dalam membina, melestarikan, dan mengembangkan kreativitas seni di Bali. Berkomitmen untuk terus mewadahi generasi muda dalam berkarya tanpa kehilangan akar budaya.",
  quote: "Jangan pernah berhenti berkreativitas dalam situasi apa pun. Seniman dengan intuisinya akan selalu timbul ide-ide kreatif dalam mencipta. Tetaplah berkarya, semangat dalam segala situasi, maju, jaya, karena apa yang diperbuat untuk kebaikan akan memberi jalan untuk kesejahteraan."
};
---

<section id="pembina" class="py-20 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto bg-black text-white border-b border-neutral-900">
  
  <!-- Header Section Minimalis -->
  <div class="mb-10 space-y-2 text-center md:text-left">
    <div class="flex items-center justify-center md:justify-start gap-2 text-red-600 font-mono text-xs uppercase tracking-widest">
      <span class="w-2 h-2 rounded-full bg-red-600"></span>
      Profil Pengampu
    </div>

    <h2 class="text-[clamp(2rem,4vw,3.25rem)] font-extrabold tracking-tight leading-tight">
      Pembina Sanggar
    </h2>
  </div>

  <!-- Poster Card (Foto dengan Teks Overlay) -->
  <div class="relative w-full rounded-2xl overflow-hidden border border-white/10 bg-neutral-950 group">
    
    <!-- Gambar Background Full Height -->
    <div class="relative w-full h-137.5 sm:h-150 md:h-162.5">
      <img 
        src={pembina.foto} 
        alt={pembina.nama}
        class="w-full h-full object-cover object-top filter grayscale contrast-110 group-hover:grayscale-0 group-hover:scale-105 transition duration-700 ease-out"
      />
      
      <!-- Gradient Overlay Hitam (Menjaga Keterbacaan Teks) -->
      <div class="absolute inset-0 bg-linear-to-t from-black via-black/70 to-transparent z-10" aria-hidden="true"></div>
    </div>

    <!-- Content Overlay di Atas Gambar -->
    <div class="absolute inset-x-0 bottom-0 z-20 p-6 sm:p-10 md:p-12 space-y-4">
      
      <!-- Jabatan / Badge -->
      <span class="inline-block font-mono text-xs text-red-500 tracking-widest uppercase border border-red-600/40 bg-red-950/40 px-3 py-1 rounded-full backdrop-blur-md">
        {pembina.jabatan}
      </span>

      <!-- Nama & Gelar -->
      <div>
        <h3 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-none">
          {pembina.nama}
        </h3>
        <p class="text-red-600 font-semibold text-lg sm:text-xl mt-1">
          {pembina.gelar}
        </p>
      </div>

      <!-- Bio Singkat -->
      <p class="text-neutral-300 text-xs sm:text-sm md:text-base max-w-3xl font-light leading-relaxed">
        {pembina.bio}
      </p>

      <!-- Quote Singkat di Atas Foto -->
      <div class="pt-2 pl-4 border-l-2 border-red-600 max-w-3xl">
        <p class="text-neutral-200 text-xs sm:text-sm italic font-light leading-relaxed">
          "{pembina.quote}"
        </p>
      </div>

    </div>

  </div>

</section>