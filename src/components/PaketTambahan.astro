---
// 1. Interface TypeScript untuk validasi props/data
export interface AddonItem {
  id: string;
  name: string;
  price: string;
  unit?: string;
  category?: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  addons?: AddonItem[];
}

// 2. Data Default
const defaultAddons: AddonItem[] = [
  { id: "addon-1", name: "Tambahan dekorasi", price: "1.000.000", unit: "mulai", category: "Dekorasi" },
  { id: "addon-2", name: "Dekorasi custom", price: "2.500.000", unit: "mulai", category: "Dekorasi" },
  { id: "addon-3", name: "Fotografer", price: "1.500.000", unit: "mulai", category: "Dokumentasi" },
  { id: "addon-4", name: "Videografer", price: "2.000.000", unit: "mulai", category: "Dokumentasi" },
  { id: "addon-5", name: "Foto + video", price: "3.000.000", unit: "mulai", category: "Dokumentasi" },
  { id: "addon-6", name: "Sound system tambahan", price: "1.000.000", unit: "mulai", category: "Teknis & Peralatan" },
  { id: "addon-7", name: "Lighting", price: "1.000.000", unit: "mulai", category: "Teknis & Peralatan" },
  { id: "addon-8", name: "Gamelan Bali", price: "1.500.000", unit: "mulai", category: "Seni & Pertunjukan" },
  { id: "addon-9", name: "Pertunjukan tari Bali", price: "1.500.000", unit: "mulai", category: "Seni & Pertunjukan" },
  { id: "addon-10", name: "Workshop tari Bali", price: "1.500.000", unit: "mulai", category: "Seni & Pertunjukan" },
  { id: "addon-11", name: "Workshop gamelan", price: "1.500.000", unit: "mulai", category: "Seni & Pertunjukan" },
  { id: "addon-12", name: "Tata rias Bali", price: "500.000", unit: "/ orang", category: "Tata Rias & Kostum" },
  { id: "addon-13", name: "Kostum Bali", price: "500.000", unit: "/ orang", category: "Tata Rias & Kostum" },
  { id: "addon-14", name: "Dekorasi khusus wedding", price: "By request", unit: "", category: "Dekorasi" },
  { id: "addon-15", name: "Dokumentasi drone", price: "By request", unit: "", category: "Dokumentasi" }
];

// 3. Destrukturisasi Props
const {
  title = "ADD-ON / FASILITAS TAMBAHAN",
  subtitle = "Lengkapi paket acara Anda dengan berbagai layanan pilihan sesuai kebutuhan",
  addons = defaultAddons
} = Astro.props;
---

<!-- Main Section ID -->
<section id="add-on-fasilitas" class="max-w-5xl mx-auto p-4 sm:p-6 font-sans">
  <!-- Section Title -->
  <div class="text-center mb-10">
    <span class="text-emerald-600 font-semibold text-xs sm:text-sm tracking-widest uppercase">Custom Options</span>
    <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-300 tracking-wide mt-1">
      {title}
    </h2>
    <p class="text-slate-600 mt-2 text-sm sm:text-base max-w-2xl mx-auto">
      {subtitle}
    </p>
  </div>

  <!-- Add-On Table Component -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-900 text-white text-xs sm:text-sm uppercase tracking-wider">
            <th class="py-4 px-6 font-bold">Fasilitas / Layanan</th>
            <th class="py-4 px-6 font-bold text-right">Harga</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-sm">
          {addons.map((addon: AddonItem) => (
            <tr id={addon.id} class="hover:bg-slate-50 transition-colors">
              <td class="py-3.5 px-6 font-medium text-slate-800 flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
                <span>{addon.name}</span>
              </td>
              <td class="py-3.5 px-6 font-semibold text-slate-900 text-right whitespace-nowrap">
                {addon.price.toLowerCase().includes("request") ? (
                  <span class="inline-block bg-amber-100 text-amber-900 text-xs font-bold px-2.5 py-1 rounded-full">
                    {addon.price}
                  </span>
                ) : (
                  <span>
                    <span class="text-xs text-slate-400 font-normal mr-1">
                      {addon.unit === "mulai" ? "Mulai" : ""}
                    </span>
                    <span class="text-emerald-700">Rp</span> {addon.price}
                    {addon.unit && addon.unit !== "mulai" && (
                      <span class="text-xs text-slate-500 font-normal ml-1">{addon.unit}</span>
                    )}
                  </span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>