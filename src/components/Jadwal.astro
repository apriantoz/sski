---
const jadwal = [
  { 
    bidang: "Tari Bali", 
    hari: "Sabtu", 
    jam: "15.00 - 17.00 WITA", 
    tingkat: "Kelas Pemula & Dewasa" 
  },
  { 
    bidang: "Seni Tabuh", 
    hari: "Kamis", 
    jam: "18.00 - 19.00 WITA",
    tingkat: "Kelas Tabuh & Karawitan" 
  },
  { 
    bidang: "Seni Tabuh", 
    hari: "Minggu", 
    jam: "11.00 - 12.00 WITA",
    tingkat: "Kelas Pemula & Lanjutan" 
  },
];
---

<section id="jadwal" class="py-20 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto text-white border-b border-neutral-900">
  
  <div class="mb-14 space-y-2">
    <span class="text-red-600 font-mono text-xs uppercase tracking-widest block">Agendakan Latihan</span>
    <h2 class="text-[clamp(2rem,4vw,3.25rem)] font-extrabold tracking-tight">Jadwal Latihan</h2>
  </div>

  <div class="relative pl-6 border-l border-neutral-800 space-y-10">
    {jadwal.map((item) => (
      <div class="relative group">
        <!-- Dot Indicator -->
        <div class="absolute -left-7.75 top-1.5 w-3 h-3 rounded-full bg-neutral-900 border border-neutral-700 group-hover:bg-red-600 group-hover:border-red-600 transition duration-300"></div>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 sm:gap-6">
          <div>
            <span class="text-red-600 font-mono text-xs uppercase tracking-wider block">{item.bidang}</span>
            <h3 class="text-2xl font-bold text-white mt-0.5">{item.hari}</h3>
          </div>

          <div class="flex flex-col sm:items-end gap-1">
            <span class="text-lg font-medium text-neutral-200 font-mono">{item.jam}</span>
            <span class="text-xs text-neutral-400 font-light">{item.tingkat}</span>
          </div>
        </div>
      </div>
    ))}
  </div>

</section>