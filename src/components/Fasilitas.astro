---
const fasilitas = [
  "Ruang Latihan Nyaman & Luas",
  "Peralatan Gamelan & Musik",
  "Kostum & Tata Rias Tari",
  "Area Panggung Pertunjukan",
  "Ruang Ganti & Toilet Bersih",
  "Kantin & Area Parkir Luas"
];
---

<section id="fasilitas" class="py-20 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto text-white border-b border-neutral-900">
  
  <div class="grid lg:grid-cols-12 gap-10 items-start">
    
    <!-- Left Column: Header -->
    <div class="lg:col-span-5 space-y-3 pl-6 border-l-2 border-red-600">
      <div class="text-red-600 font-mono text-xs uppercase tracking-widest">
        Sarana & Prasarana
      </div>
      <h2 class="text-[clamp(2rem,4vw,3rem)] font-extrabold tracking-tight leading-none">
        Fasilitas Sanggar
      </h2>
      <p class="text-neutral-400 text-sm sm:text-base font-light leading-relaxed pt-2">
        Lingkungan belajar dan berkreasi yang dirancang nyaman, representatif, serta mendukung perkembangan karya para anggota.
      </p>
    </div>

    <!-- Right Column: Pill List -->
    <div class="lg:col-span-7 grid sm:grid-cols-2 gap-4">
      {fasilitas.map((item, index) => (
        <div class="p-4 rounded-xl bg-neutral-950 border border-white/10 hover:border-red-600/50 transition duration-300 flex items-center gap-3">
          <span class="font-mono text-xs text-red-600 font-bold">0{index + 1}</span>
          <span class="text-neutral-200 text-sm sm:text-base font-medium">{item}</span>
        </div>
      ))}
    </div>

  </div>

</section>