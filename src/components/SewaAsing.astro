---
// 1. Interface TypeScript untuk validasi props/data
export interface WorkshopPackage {
  id: string;
  name: string;
  duration: string;
  minPax: string;
  price: string;
  isPopular?: boolean;
  isVIP?: boolean;
  tagline?: string;
  features: string[];
}

export interface Props {
  title?: string;
  subtitle?: string;
  packages?: WorkshopPackage[];
}

// 2. Data Default (jika tidak dipass dari luar)
const defaultPackages: WorkshopPackage[] = [
  {
    id: "bali-cultural-experience",
    name: "Bali Cultural Experience",
    duration: "1–2 Hours",
    minPax: "Min. 5 Pax",
    price: "350.000",
    features: [
      "Welcome drink & Cultural introduction",
      "Basic Balinese dance workshop",
      "Introduction to Balinese gamelan",
      "Balinese costume experience",
      "Photo session (costume & group)",
      "Digital documentation"
    ]
  },
  {
    id: "authentic-balinese-art-experience",
    name: "Authentic Balinese Art Experience",
    duration: "1–2 Hours",
    minPax: "Min. 5 Pax",
    price: "500.000",
    isPopular: true,
    features: [
      "Welcome drink & traditional Balinese snack",
      "Cultural introduction, dance & gamelan workshop",
      "Balinese costume dressing",
      "Basic Balinese dance performance",
      "Professional photo session (Pendopo & Garden)",
      "Digital documentation"
    ]
  },
  {
    id: "private-balinese-cultural-experience",
    name: "Private Balinese Cultural Experience",
    duration: "1–2 Hours",
    minPax: "1–5 Pax Only",
    price: "750.000",
    isVIP: true,
    tagline: "Personalized VIP cultural session tailored for guests seeking an intimate experience.",
    features: [
      "Private cultural tour",
      "Private dance & gamelan workshop",
      "Exclusive Balinese costume dressing",
      "Professional photo session (Solo & Group)",
      "Digital documentation & Balinese snacks"
    ]
  }
];

// 3. Destrukturisasi Props
const {
  title = "PPAKET WORKSHOP UNTUK WISATAWAN ASING",
  subtitle = "Immersive and authentic Balinese cultural experiences designed for international visitors and small groups.",
  packages = defaultPackages
} = Astro.props;
---

<!-- Main Section ID -->
<section id="paket-workshop-asing" class="max-w-7xl mx-auto p-4 sm:p-6 font-sans">
  <!-- Section Title -->
  <div class="text-center mb-10">
    <span class="text-emerald-600 font-semibold text-xs sm:text-sm tracking-widest uppercase">Special Offers</span>
    <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-300 tracking-wide mt-1">
      {title}
    </h2>
    <p class="text-slate-600 mt-2 text-sm sm:text-base max-w-2xl mx-auto">
      {subtitle}
    </p>
  </div>

  <!-- Grid Render Loop (.map) -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch">
    {packages.map((pkg) => (
      <article
        id={pkg.id}
        class={`rounded-2xl shadow-sm transition-all overflow-hidden flex flex-col justify-between relative ${
          pkg.isVIP
            ? "bg-slate-900 text-white border border-slate-800 shadow-xl"
            : pkg.isPopular
            ? "bg-white border-2 border-emerald-600 shadow-md"
            : "bg-white border border-slate-200 hover:shadow-md"
        }`}
      >
        <!-- Badge Populer / VIP -->
        {pkg.isPopular && (
          <div class="absolute top-0 right-0 bg-emerald-600 text-white text-[10px] uppercase tracking-wider font-bold px-3 py-1 rounded-bl-lg">
            Most Popular
          </div>
        )}
        {pkg.isVIP && (
          <div class="absolute top-0 right-0 bg-amber-500 text-slate-950 text-[10px] uppercase tracking-wider font-bold px-3 py-1 rounded-bl-lg">
            Exclusive VIP
          </div>
        )}

        <div class="p-6">
          <!-- Header Card -->
          <div class="mb-4">
            <span
              class={`text-xs font-semibold px-2.5 py-1 rounded-full ${
                pkg.isVIP
                  ? "bg-slate-800 text-amber-400 border border-amber-400/30"
                  : "bg-emerald-100 text-emerald-800"
              }`}
            >
              {pkg.minPax}
            </span>
            <h3 class={`text-xl font-bold mt-3 ${pkg.isVIP ? "text-white" : "text-slate-800"}`}>
              {pkg.name}
            </h3>
            <p class={`text-sm mt-1 ${pkg.isVIP ? "text-slate-400" : "text-slate-500"}`}>
              Duration: {pkg.duration}
            </p>
          </div>

          <!-- Tagline jika VIP -->
          {pkg.tagline && (
            <p class="text-slate-300 text-xs italic mb-4">
              {pkg.tagline}
            </p>
          )}

          <!-- Harga -->
          <div
            class={`flex items-baseline gap-1 my-4 p-3 rounded-xl border ${
              pkg.isVIP
                ? "bg-slate-800/80 border-slate-700"
                : pkg.isPopular
                ? "bg-emerald-50 border-emerald-100"
                : "bg-slate-50 border-slate-100"
            }`}
          >
            <span class={`text-sm font-medium ${pkg.isVIP ? "text-amber-400" : pkg.isPopular ? "text-emerald-700" : "text-slate-500"}`}>
              IDR
            </span>
            <span class={`text-2xl sm:text-3xl font-extrabold ${pkg.isVIP ? "text-white" : "text-slate-900"}`}>
              {pkg.price}
            </span>
            <span class={`text-sm ${pkg.isVIP ? "text-slate-400" : "text-slate-500"}`}>
              / pax
            </span>
          </div>

          <!-- List Fitur -->
          <div class={`border-t pt-4 ${pkg.isVIP ? "border-slate-800" : "border-slate-100"}`}>
            <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">
              {pkg.isVIP ? "VIP Amenities:" : "Included Programs:"}
            </h4>
            <ul class={`space-y-2.5 text-sm ${pkg.isVIP ? "text-slate-300" : "text-slate-600"}`}>
              {pkg.features.map((feature) => (
                <li class="flex items-start gap-2">
                  <svg
                    class={`w-4 h-4 shrink-0 mt-0.5 ${pkg.isVIP ? "text-amber-400" : "text-emerald-500"}`}
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Button Action -->
        <div class="p-6 pt-0">
          <button
            class={`w-full font-medium py-2.5 px-4 rounded-xl transition-colors ${
              pkg.isVIP
                ? "bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold"
                : pkg.isPopular
                ? "bg-emerald-600 hover:bg-emerald-700 text-white"
                : "bg-slate-900 hover:bg-slate-800 text-white"
            }`}
          >
            {pkg.isVIP ? "Book Private Experience" : "Book Experience"}
          </button>
        </div>
      </article>
    ))}
  </div>
</section>