---
const jadwal = [
  { 
    bidang: "Tari Bali", 
    hari: "Sabtu", 
    jam: "15.00 - 17.00 WITA", 
    tingkat: "Kelas Pemula & Dewasa" 
  },
  { 
    bidang: "Seni Tabuh", 
    hari: "Kamis", 
    jam: "18.00 - 19.00 WITA",
    tingkat: "Kelas Tabuh & Karawitan" 
  },
  { 
    bidang: "Seni Tabuh", 
    hari: "Minggu", 
    jam: "11.00 - 12.00 WITA",
    tingkat: "Kelas Pemula & Lanjutan" 
  },
];
---
<section id="jadwal" class="py-20 px-4">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl font-bold text-center mb-10 border-b-2 border-rose-500 w-fit mx-auto pb-2">
      Jadwal Latihan
    </h2>
    <div class="grid md:grid-cols-2 gap-6">
      {jadwal.map((item) => (
        <div class="bg-white p-6 rounded-xl shadow-sm border-l-4 border-l-rose-500 border border-stone-200">
          <span class="text-rose-500 font-bold text-xs tracking-widest uppercase">{item.bidang}</span>
          <h3 class="text-xl font-bold mt-1 text-stone-900">{item.hari}</h3>
          <p class="text-stone-700 font-medium mt-1">{item.jam}</p>
          <span class="inline-block mt-3 bg-stone-100 text-stone-600 text-xs px-3 py-1 rounded-full">
            {item.tingkat}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>