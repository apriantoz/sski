<nav class="fixed top-0 left-0 w-full z-50 bg-stone-900/90 backdrop-blur text-white shadow-md">
  <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
    
    <!-- Brand / Logo Gambar -->
    <a href="#" class="flex items-center gap-2 hover:opacity-90 transition">
      <div
        class="w-12 h-10 md:w-16 md:h-12 bg-rose-500 object-contain transition-colors group-hover:bg-rose-400"
        style="-webkit-mask-image: url('/images/logo-sski-2.png'); mask-image: url('/images/logo-sski-2.png'); -webkit-mask-size: contain; mask-size: contain; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; -webkit-mask-position: center; mask-position: center;"
        aria-label="Logo Sanggar Seni"></div>
      <span class="font-bold text-base md:text-lg tracking-wider text-rose-500 hidden sm:inline-block">SANGGAR SENI KEBO IWA</span>
    </a>

    <!-- Tombol Hamburger -->
    <button 
      id="menu-toggle"
      type="button" 
      class="md:hidden text-stone-300 hover:text-white focus:outline-none p-1 transition-colors"
      aria-label="Toggle Menu">
      <!-- Ikon Hamburger -->
      <svg id="icon-open" class="w-6 h-6 transition-opacity duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <!-- Ikon Close -->
      <svg id="icon-close" class="w-6 h-6 hidden transition-opacity duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <!-- Menu Desktop (md+) -->
    <ul class="hidden md:flex space-x-3 sm:space-x-6 text-xs sm:text-sm font-medium">
      <li><a href="#profil" class="hover:text-rose-500 transition px-1 py-1">Profil</a></li>
      <li><a href="#kegiatan" class="hover:text-rose-500 transition px-1 py-1">Kegiatan</a></li>
      <li><a href="#jadwal" class="hover:text-rose-500 transition px-1 py-1">Jadwal</a></li>
      <li><a href="#fasilitas" class="hover:text-rose-500 transition px-1 py-1">Fasilitas</a></li>
      <li><a href="#layanan" class="hover:text-rose-500 transition px-1 py-1">Layanan</a></li>
      <li><a href="#galeri" class="hover:text-rose-500 transition px-1 py-1">Galeri</a></li>
      <li><a href="#medsos" class="hover:text-rose-500 transition px-1 py-1">Medsos</a></li>
      <li><a href="#kontak" class="hover:text-rose-500 transition px-1 py-1">Kontak</a></li>
    </ul>
  </div>

  <!-- Menu Mobile (Smooth Accordion Dropdown) -->
  <div 
    id="mobile-menu" 
    class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out md:hidden bg-stone-900/95 border-t border-stone-800">
    <div class="overflow-hidden">
      <div class="px-4 pt-2 pb-4 space-y-2 text-sm font-medium">
        <a href="#profil" class="mobile-link block hover:text-rose-500 py-2 transition">Profil</a>
        <a href="#kegiatan" class="mobile-link block hover:text-rose-500 py-2 transition">Kegiatan</a>
        <a href="#jadwal" class="mobile-link block hover:text-rose-500 py-2 transition">Jadwal</a>
        <a href="#fasilitas" class="mobile-link block hover:text-rose-500 py-2 transition">Fasilitas</a>
        <a href="#layanan" class="mobile-link block hover:text-rose-500 py-2 transition">Layanan</a>
        <a href="#galeri" class="mobile-link block hover:text-rose-500 py-2 transition">Galeri</a>
        <a href="#medsos" class="mobile-link block hover:text-rose-500 py-2 transition">Medsos</a>
        <a href="#kontak" class="mobile-link block hover:text-rose-500 py-2 transition">Kontak</a>
      </div>
    </div>
  </div>
</nav>

<script>
  function setupNavbar() {
    const toggleBtn = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');
    const mobileLinks = document.querySelectorAll('.mobile-link');

    if (toggleBtn && mobileMenu) {
      const closeMenu = () => {
        mobileMenu.classList.remove('grid-rows-[1fr]');
        mobileMenu.classList.add('grid-rows-[0fr]');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
      };

      const openMenu = () => {
        mobileMenu.classList.remove('grid-rows-[0fr]');
        mobileMenu.classList.add('grid-rows-[1fr]');
        iconOpen?.classList.add('hidden');
        iconClose?.classList.remove('hidden');
      };

      // Toggle saat tombol hamburger diklik
      toggleBtn.addEventListener('click', () => {
        const isOpen = mobileMenu.classList.contains('grid-rows-[1fr]');
        if (isOpen) {
          closeMenu();
        } else {
          openMenu();
        }
      });

      // Tutup menu smooth saat link diklik
      mobileLinks.forEach((link) => {
        link.addEventListener('click', closeMenu);
      });
    }
  }

  setupNavbar();
  document.addEventListener('astro:after-swap', setupNavbar);
</script>