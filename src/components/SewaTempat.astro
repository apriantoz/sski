---
// 1. Interface TypeScript untuk validasi props/data
export interface VenueRentalPackageItem {
  id: string;
  name: string;
  duration: string;
  price: string;
  isPopular?: boolean;
}

export interface Props {
  title?: string;
  subtitle?: string;
  venueName?: string;
  packages?: VenueRentalPackageItem[];
  standardFeatures?: string[];
}

// 2. Data Default
const defaultPackages: VenueRentalPackageItem[] = [
  {
    id: "venue-rental-4-jam",
    name: "Paket 4 Jam",
    duration: "4 Jam Durasi Sewa",
    price: "2.000.000"
  },
  {
    id: "venue-rental-8-jam",
    name: "Paket 8 Jam",
    duration: "8 Jam Durasi Sewa",
    price: "3.500.000",
    isPopular: true
  },
  {
    id: "venue-rental-full-day",
    name: "Paket Full Day",
    duration: "Penggunaan Sepanjang Hari",
    price: "5.000.000"
  }
];

const defaultStandardFeatures: string[] = [
  "Pendopo & Area taman",
  "Pasokan listrik venue",
  "Meja dan kursi standar",
  "Sound system standar",
  "Area parkir & Toilet",
  "Area persiapan / ruang ganti",
  "Area foto spot budaya"
];

// 3. Destrukturisasi Props
const {
  title = "PAKET SEWA TEMPAT SAJA",
  subtitle = "Sewa lokasi eksklusif untuk berbagai kebutuhan acara mandiri Anda",
  venueName = "Venue Rental – Pendopo Taman SSKI",
  packages = defaultPackages,
  standardFeatures = defaultStandardFeatures
} = Astro.props;
---

<!-- Main Section ID -->
<section id="paket-sewa-tempat" class="max-w-6xl mx-auto p-4 sm:p-6 font-sans">
  <!-- Section Title -->
  <div class="text-center mb-10">
    <span class="text-cyan-600 font-semibold text-xs sm:text-sm tracking-widest uppercase">Only Venue Rental</span>
    <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-300 tracking-wide mt-1">
      {title}
    </h2>
    <p class="text-cyan-700 font-medium text-sm sm:text-base mt-1">
      {venueName}
    </p>
    <p class="text-slate-600 mt-1 text-xs sm:text-sm max-w-2xl mx-auto">
      {subtitle}
    </p>
  </div>

  <!-- Grid Pilihan Durasi/Harga (.map) -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch mb-10">
    {packages.map((pkg: VenueRentalPackageItem) => (
      <article
        id={pkg.id}
        class={`rounded-2xl transition-all overflow-hidden flex flex-col justify-between relative ${
          pkg.isPopular
            ? "bg-white border-2 border-cyan-600 shadow-md"
            : "bg-white border border-slate-200 hover:shadow-md"
        }`}
      >
        <!-- Badge Populer -->
        {pkg.isPopular && (
          <div class="absolute top-0 right-0 bg-cyan-600 text-white text-[10px] uppercase tracking-wider font-bold px-3 py-1 rounded-bl-lg">
            Paling Laris
          </div>
        )}

        <div class="p-6">
          <span class="bg-cyan-100 text-cyan-800 text-xs font-semibold px-2.5 py-1 rounded-full">
            {pkg.duration}
          </span>
          <h3 class="text-xl font-bold text-slate-800 mt-3">
            {pkg.name}
          </h3>

          <!-- Harga -->
          <div
            class={`flex items-baseline gap-1 my-4 p-3 rounded-xl border ${
              pkg.isPopular ? "bg-cyan-50 border-cyan-100" : "bg-slate-50 border-slate-100"
            }`}
          >
            <span class={`text-sm font-medium ${pkg.isPopular ? "text-cyan-700" : "text-slate-500"}`}>
              Rp
            </span>
            <span class="text-2xl sm:text-3xl font-extrabold text-slate-900">
              {pkg.price}
            </span>
          </div>
        </div>

        <!-- Action Button -->
        <div class="p-6 pt-0">
          <button
            class={`w-full font-medium py-2.5 px-4 rounded-xl transition-colors ${
              pkg.isPopular
                ? "bg-cyan-600 hover:bg-cyan-700 text-white"
                : "bg-slate-900 hover:bg-slate-800 text-white"
            }`}
          >
            Pesan Durasi Ini
          </button>
        </div>
      </article>
    ))}
  </div>

  <!-- Shared Standard Facilities Box -->
  <div class="bg-slate-900 text-white rounded-2xl p-6 sm:p-8 border border-slate-800 shadow-lg">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-4 mb-6">
      <div>
        <h3 class="text-lg font-bold text-white">Fasilitas Standar Sewa Tempat</h3>
        <p class="text-slate-400 text-xs sm:text-sm mt-0.5">Semua opsi durasi sewa di atas sudah termasuk fasilitas berikut:</p>
      </div>
      <span class="bg-cyan-950 text-cyan-400 border border-cyan-800 text-xs font-semibold px-3 py-1 rounded-full w-fit">
        Included All Packages
      </span>
    </div>

    <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 text-sm text-slate-300">
      {standardFeatures.map((feature: string) => (
        <li class="flex items-center gap-2">
          <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span>{feature}</span>
        </li>
      ))}
    </ul>
  </div>
</section>