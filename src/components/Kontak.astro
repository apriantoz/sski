<section id="kontak" class="py-20 px-4 bg-stone-900 text-stone-100">
  <div class="max-w-4xl mx-auto text-center">
    <!-- Header Kontak -->
    <span class="text-amber-500 font-semibold tracking-widest uppercase text-xs sm:text-sm block mb-2">
      Lokasi & Kontak
    </span>
    <h2 class="text-3xl sm:text-4xl font-bold mb-4 text-white">Kunjungi Sanggar Kami</h2>
    <p class="text-stone-300 mb-8 max-w-xl mx-auto text-sm sm:text-base leading-relaxed">
      Br. Kwanji Kelod. No 38 B Sempidi, Mengwi, Badung, Bali, Indonesia 80351
    </p>

    <!-- Peta Google Maps Embed Presisi -->
    <div class="w-full h-80 sm:h-96 rounded-2xl overflow-hidden border border-stone-700 shadow-xl mb-8">
      <iframe 
        title="Peta Lokasi Pendopo Taman SSKI"
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3944.821!2d115.1843!3d-8.5833!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2dd239002ae0d115%3A0xab7d62244cb46fc3!2sPendopo%20Taman%20SSKI!5e0!3m2!1sid!2sid!4v1700000000000!5m2!1sid!2sid" 
        width="100%" 
        height="100%" 
        style="border:0;" 
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="no-referrer-when-downgrade"
        class="filter grayscale contrast-125 hover:filter-none transition duration-500"
      ></iframe>
    </div>

    <!-- Tombol Aksi (WhatsApp & Link Google Maps Akurat) -->
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <a 
        href="https://wa.me/628124602907" 
        target="_blank" 
        rel="noopener noreferrer"
        class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-6 py-3 rounded-xl transition shadow-lg flex items-center justify-center gap-2"
      >
        💬 Hubungi via WhatsApp
      </a>
      
      <a 
        href="https://maps.app.goo.gl/HGSk8sChbZwdLAwq6" 
        target="_blank" 
        rel="noopener noreferrer"
        class="bg-stone-800 hover:bg-stone-700 text-amber-400 font-semibold px-6 py-3 rounded-xl border border-stone-700 transition flex items-center justify-center gap-2"
      >
        📍 Buka di Google Maps ↗
      </a>
    </div>
  </div>
</section>