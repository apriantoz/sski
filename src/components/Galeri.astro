---
import { getCollection, type CollectionEntry } from 'astro:content';

// Ambil data galeri dari loader glob .json
const galeriList: CollectionEntry<'galeri'>[] = await getCollection('galeri');

// Urutkan berdasarkan tanggal terbaru dengan Type Safety
const sortedGaleri = galeriList.sort((a: CollectionEntry<'galeri'>, b: CollectionEntry<'galeri'>) => {
  if (!a.data.date || !b.data.date) return 0;
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});
---

<section id="galeri" class="py-20 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto bg-black text-white border-b border-neutral-900">
  
  <!-- Header Section -->
  <div class="mb-14 sm:mb-20 space-y-3">
    <div class="flex items-center gap-2 text-red-600 font-mono text-xs uppercase tracking-widest">
      <span class="w-2 h-2 rounded-full bg-red-600"></span>
      Dokumentasi Visual
    </div>

    <h2 class="text-[clamp(2rem,4vw,3.25rem)] font-extrabold tracking-tight leading-tight">
      Galeri Kegiatan Sanggar
    </h2>

    <p class="text-neutral-400 text-[clamp(0.95rem,1.5vw,1.15rem)] max-w-xl font-light">
      Momen-momen pementasan, latihan intensif, dan aktivitas kebudayaan yang terabadikan.
    </p>
  </div>

  <!-- Minimalist Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10 md:gap-12">
    {sortedGaleri.map((item: CollectionEntry<'galeri'>) => (
        <article class="group relative pl-6 border-l border-neutral-800 hover:border-red-600 transition-colors duration-300 space-y-4">
          
          <!-- Image Frame -->
          <div class="relative overflow-hidden bg-neutral-900 aspect-4/3 w-full">
            <img 
              src={item.data.image} 
              alt={item.data.title}
              loading="lazy"
              class="w-full h-full object-cover grayscale contrast-125 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-500 ease-out"
            />
            <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors duration-300"></div>
          </div>

          <!-- Date Badge -->
          {item.data.date && (
            <div class="flex items-center text-[11px] font-mono text-red-600 uppercase tracking-widest pt-1">
              <span class="w-1.5 h-1.5 rounded-full bg-red-600 mr-2 shrink-0"></span>
              {new Date(item.data.date).toLocaleDateString('id-ID')}
            </div>
          )}

          <!-- Title -->
          <h3 class="text-lg sm:text-xl font-bold text-white tracking-tight leading-snug group-hover:text-red-500 transition-colors">
            {item.data.title}
          </h3>

        </article>
    ))}
  </div>

  <!-- Fallback Jika Belum Ada Data -->
  {sortedGaleri.length === 0 && (
    <div class="text-center py-12 text-neutral-500 font-mono text-sm">
      Belum ada foto yang diunggah.
    </div>
  )}

</section>